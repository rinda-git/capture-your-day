<%= content_for(:title, t('.title', default: APP_NAME)) %>
<div class="flex-grow px-2 sm:px-6 md:px-10">
  <div class="max-w-4xl mx-auto pt-2 pb-6 sm:pt-6 md:px-0">
    <h1 class="font-sans font-semibold text-lg md:text-3xl sm:text-2xl text-center mb-6">
      <%= t('.title') %>
    </h1>
      <div class="card bg-base-100 shadow mb-4 p-3">
        <h2 class="card-title">プロフィール</h2>
        <div class="flex flex-col gap-2 text-sm sm:text-base mt-2">
          <% if current_user.profile_image.attached? %>
            <%= image_tag current_user.profile_image, class: "w-16 h-16 rounded-full object-cover" %> 
          <% else %>
            <div class="w-16 h-16 rounded-full bg-base-300 flex items-center justify-center font-semibold">
            <%= current_user.name.to_s.first || "?"  %>
            </div>
          <% end %>
          <p>名前：<%= current_user.name %></p>
          <div class="flex items-center justify-between gap-3">
          <p>メールアドレス：<%= current_user.email %></p>
           <%= link_to "編集", edit_user_path, class:"btn btn-sm btn-secondary px-6 mr-4 hover:bg-base-300 hover:text-base-400" %>
          </div>
        </div>


      </div>

      <%= link_to line_connection_path, class:"card bg-base-100 shadow mb-4 p-3 hover:bg-base-300 transition" do %>
        <h2 class="card-title">LINE通知設定</h2>
      <% end %>

      <div class="card bg-base-100 shadow mb-4 p-3">
        <h2 class="card-title">リマインダー通知設定</h2>
      </div>

      <%= link_to terms_path, class:"card bg-base-100 shadow mb-4 p-3 hover:bg-base-300 transition" do %>
        <h2 class="card-title">利用規約</h2>
      <% end %>

      <%= link_to privacy_path, class:"card bg-base-100 shadow mb-4 p-3 hover:bg-base-300 transition" do %>
        <h2 class="card-title">プライバシーポリシー</h2>
      <% end %>

      <%= link_to "https://forms.gle/7sn6QhgAaWt6FtnK7", 
          target: "_blank",
          rel: "noopener",
          class:"card bg-base-100 shadow mb-4 p-3 hover:bg-base-300 transition" do %>
        <h2 class="card-title">お問い合わせ</h2>
      <% end %>
      
  </div>
</div>

