<%# flash の種類ごとに DaisyUI の alert クラスを切り替える %>
<% flash.each do |type, message| %>
  <% next if message.blank? %>

  <% alert_class = case type.to_sym
    when :notice, :success then "alert alert-success"
    when :alert  then "alert alert-error"
    when :warning then "alert alert-warning"
    else              "alert alert-info"
    end
  %>

  <div class="mx-auto w-full max-w-5xl px-2 sm:px-6 md:px-10 mt-2">
    <div role="alert" class="<%= alert_class %>  shadow-sm text-sm sm:text-base">
      <span><%= message %></span>
    </div>
  </div>
<% end %>
